# ==============================================================================
# Saylani HCM Lite — Server Environment Configuration
# ==============================================================================

PORT=2002
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hcm_lite?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_min_32_characters_long

# AI Assistant Configuration
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-3.5-turbo

# CORS Origins
CLIENT_ORIGIN=http://localhost:3003

# Cold-boot Bootstrap (Optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_APP_FOLDER=hcm_lite
