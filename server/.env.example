# Server Configuration
PORT=2002

# Database Configuration
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT Authentication
# Secret key used for signing and verifying JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_VALUE=your_jwt_secret_value_here

# Cloudinary Configuration (Used for profile image / avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_APP_FOLDER=mern-template
