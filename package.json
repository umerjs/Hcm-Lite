{
  "name": "hcm-lite",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "bun install",
    "dev": "bun --parallel --filter '*' run dev",
    "format": "bunx prettier --write .",
    "dev:client": "cd client && bun run dev",
    "dev:server": "cd server && bun run dev",
    "build": "cd client && bun run build"
  }
}
