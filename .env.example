# ========================================================
# Backend Environment Variables (copy to Backend/.env)
# ========================================================
PORT=2002
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_APP_FOLDER=mern-template

# ========================================================
# Frontend Environment Variables (copy to Frontend/.env)
# ========================================================
VITE_FRONTEND_URL=http://localhost:3003
VITE_BACKEND_URL=http://localhost:2002
