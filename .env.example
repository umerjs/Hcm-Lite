# ==============================================================================
# Saylani HCM Lite — Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=2002

# MongoDB Connection String (Atlas or Local MongoDB instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hcm_lite?retryWrites=true&w=majority

# JWT Secret Key (min 32 characters, used for signing authentication tokens)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long

# AI Assistant Integration (OpenAI-compatible endpoint: OpenAI, Groq, or Gemini)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-3.5-turbo

# Client CORS Configuration (comma-separated allowed origins)
CLIENT_ORIGIN=http://localhost:3003

# Cold-boot Administrator Bootstrap (Optional)
# If provided, creates this Admin user on startup if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary Storage (Optional — used for employee avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_APP_FOLDER=hcm_lite
